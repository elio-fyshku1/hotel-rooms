# PostgreSQL connection
DATABASE_URL=postgresql://hotel:hotel@localhost:5432/hotel

# Long random string used to sign login sessions (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# Set to true when the app is served over HTTPS
COOKIE_SECURE=false

# Initial admin login created by `npm run db:setup` (change the password after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
